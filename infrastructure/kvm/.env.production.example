# Umrah Connect API — production environment (Hostinger KVM 8).
# Copy to .env.production ON THE SERVER ONLY (chmod 600). Never commit real values.

# ── Hosting ──────────────────────────────────────────────────────────────
API_DOMAIN=api.umrahconnect.io
ACME_EMAIL=
API_IMAGE=umrah-connect-api:latest

# ── PostgreSQL (container) ───────────────────────────────────────────────
POSTGRES_DB=umrah_connects
POSTGRES_USER=umrah
POSTGRES_PASSWORD=

# ── Core ─────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
WEB_URL=https://umrahconnect.io
CORS_ORIGINS=https://umrahconnect.io,https://www.umrahconnect.io
# Browser-visible API base used in signed document links (the web rewrite).
PUBLIC_API_BASE_URL=https://umrahconnect.io/proxy-api
AUTH_REFRESH_TOKEN_IN_BODY=true
THROTTLE_LIMIT=600
KAFKA_ENABLED=false
# Shared secret the web proxy sends as X-UC-Proxy-Secret so the API can trust the client IP header
# (Vercel: x-vercel-forwarded-for). Set the same value in the web app. Leave unset to ignore the header.
PROXY_SHARED_SECRET=
CLIENT_IP_HEADER=x-vercel-forwarded-for

# ── Object storage: Cloudflare R2 ────────────────────────────────────────
STORAGE_DRIVER=r2
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=
S3_PUBLIC_BUCKET=
S3_PUBLIC_BASE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
DOCUMENT_URL_TTL_SECONDS=300

# ── Payments: Stripe ─────────────────────────────────────────────────────
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ── Email (SMTP, e.g. Hostinger mail) ────────────────────────────────────
MAIL_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Umrah Connect <no-reply@umrahconnect.io>"

# ── Google Sign-In ───────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://umrahconnect.io/proxy-api/auth/google/callback

# ── One-off Super Admin bootstrap (remove after use) ─────────────────────
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
