# Umrah Connect API — production environment (Hostinger KVM 8).
# Copy to .env.production ON THE SERVER ONLY (owner: deploy user, chmod 600). Never commit real values.
# Format: KEY=value, one per line, no inline comments (the operations scripts read values literally).
# scripts/preflight.sh checks this file before every deployment.
# Every variable here is also passed to the API container (env_file); keep unrelated secrets out.

# ── Compose mode ─────────────────────────────────────────────────────────
# Bundled proxy (default, dedicated host): this stack's Caddy owns :80/:443.
COMPOSE_FILE=docker-compose.yml:docker-compose.bundled-proxy.yml
# Shared proxy (another reverse proxy on this host owns :80/:443) — use instead of the line above:
# COMPOSE_FILE=docker-compose.yml:docker-compose.shared-proxy.yml
# SHARED_PROXY_NETWORK=
# Bundled proxy host ports ([ip:]port). Change only for a local rehearsal.
CADDY_HTTP_PUBLISH=80
CADDY_HTTPS_PUBLISH=443

# ── Hosting ──────────────────────────────────────────────────────────────
API_DOMAIN=api.umrahconnect.io
ACME_EMAIL=
# Managed by scripts/deploy.sh (it tags each healthy release :current). Leave as is.
API_IMAGE=umrah-connect-api:current

# ── PostgreSQL (container) ───────────────────────────────────────────────
POSTGRES_DB=umrah_connects
POSTGRES_USER=umrah
# URL-safe only (it is embedded in DATABASE_URL): openssl rand -hex 32
POSTGRES_PASSWORD=
# Optional sizing for this project's share of the host (defaults: 4GB, 16GB, 100, 1g):
# PG_SHARED_BUFFERS=4GB
# PG_EFFECTIVE_CACHE_SIZE=16GB
# PG_MAX_CONNECTIONS=100
# PG_SHM_SIZE=1g

# ── Core ─────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
WEB_URL=https://umrahconnect.io
CORS_ORIGINS=https://umrahconnect.io,https://www.umrahconnect.io
# Browser-visible API base used in signed document links (the web rewrite).
PUBLIC_API_BASE_URL=https://umrahconnect.io/proxy-api
AUTH_REFRESH_TOKEN_IN_BODY=true
THROTTLE_LIMIT=600
KAFKA_ENABLED=false
# Shared secret the web proxy sends as X-UC-Proxy-Secret so the API can trust the client IP header
# (Vercel: x-vercel-forwarded-for). Set the same value in the web app. Leave unset to ignore the header.
PROXY_SHARED_SECRET=
CLIENT_IP_HEADER=x-vercel-forwarded-for

# ── Object storage: Cloudflare R2 ────────────────────────────────────────
STORAGE_DRIVER=r2
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=
S3_PUBLIC_BUCKET=
S3_PUBLIC_BASE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
DOCUMENT_URL_TTL_SECONDS=300

# ── Payments: Stripe ─────────────────────────────────────────────────────
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ── Email (SMTP, e.g. Hostinger mail) ────────────────────────────────────
MAIL_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Umrah Connect <no-reply@umrahconnect.io>"

# ── Google Sign-In ───────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://umrahconnect.io/proxy-api/auth/google/callback

# ── One-off Super Admin bootstrap (remove after use) ─────────────────────
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# ── Backups (host side; README "Backups and restore") ────────────────────
# Off-site copy destination for scripts/pg-backup.sh, as an rclone path: <remote>:<bucket>[/<prefix>]
#   remote  a remote defined in the deploy user's rclone.conf (type s3, provider Cloudflare)
#   bucket  an R2 bucket used only for database backups (3–63 chars: a-z 0-9 -), never the app buckets
# Example: OFFSITE_REMOTE=r2-backups:umrah-connect-db-backups/production
# Required in production: without it every backup run fails loudly (the local dump is still kept).
OFFSITE_REMOTE=

# ── Monitoring (host side; README "Monitoring") ──────────────────────────
# Incoming-webhook URL that receives alerts from the health timer and failed backups/cleanups.
# Treat it as a secret. Leave empty to alert only to the system journal.
ALERT_WEBHOOK_URL=
# json → POST {"text": "..."} (Slack, Mattermost, Google Chat, Teams, Discord's /slack endpoint)
# text → POST the plain message (ntfy and similar)
ALERT_WEBHOOK_FORMAT=json

# ── Orphaned-object cleanup (O04, daily timer) ───────────────────────────
# report: list what would be deleted (start here); apply: delete orphans older than the grace period.
ORPHAN_CLEANUP_MODE=report
