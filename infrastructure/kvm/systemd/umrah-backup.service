[Unit]
Description=Umrah Connect PostgreSQL backup (local dump + off-site copy)
Wants=docker.service
After=docker.service
OnFailure=umrah-alert@%n.service

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/opt/umrah-connect/infrastructure/kvm
ExecStart=/opt/umrah-connect/infrastructure/kvm/scripts/pg-backup.sh
# Dumps are private to the deploy user; a hung dump or upload must not block the next night's run.
UMask=0077
TimeoutStartSec=3h
NoNewPrivileges=yes
PrivateTmp=yes
