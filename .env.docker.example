# Local development stack (root docker-compose.yml) — THIS MACHINE ONLY.
# Copy once:  cp .env.docker.example .env   (.env is gitignored; docker compose reads it automatically)
# Every service is published on 127.0.0.1 only. These values are documented defaults for local use: change them if
# you like, and never reuse them for any shared, staging or production system (production: infrastructure/kvm/).

# PostgreSQL owner "umrah" (migrations/seeds). URL for platform/api/.env:
#   MIGRATE_DATABASE_URL="postgresql://umrah:<UC_DEV_POSTGRES_PASSWORD>@localhost:5432/umrah_connects"
# The API itself connects as the RLS runtime login (platform/api/prisma/rls/runtime-role.sql).
UC_DEV_POSTGRES_PASSWORD=local-dev-only-postgres
UC_DEV_REDIS_PASSWORD=local-dev-only-redis
UC_DEV_MINIO_ROOT_USER=uc-dev-minio
UC_DEV_MINIO_ROOT_PASSWORD=local-dev-only-minio
# pgAdmin (profile "tools": docker compose --profile tools up -d pgadmin)
UC_DEV_PGADMIN_PASSWORD=local-dev-only-pgadmin
