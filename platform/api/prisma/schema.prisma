model FxRate {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  baseCurrency  String   @default("SAR") @map("base_currency") @db.Char(3)
  quoteCurrency String   @map("quote_currency") @db.Char(3)
