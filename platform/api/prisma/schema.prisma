// ============================================================
// Umrah Connects — Prisma Schema
// PostgreSQL 15+ · tenant isolation enforced in the service layer (see docs/adr/001)
// All money: bigint minor units + currency code (no floats)
// All timestamps: timestamptz stored UTC
// All tenant-scoped tables: non-null tenant_id
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  // native = local dev; debian target = Render/Docker (node:20 bookworm, openssl 3)
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["core", "marketplace", "social", "audit", "plugin_crm", "plugin_booking", "plugin_hotel", "plugin_visa", "plugin_transport", "plugin_finance", "plugin_group_ops", "plugin_portal", "plugin_reporting"]
}

// ============================================================
// ENUMS
// ============================================================

enum TenantStatus {
  PENDING_KYC
  KYC_SUBMITTED
  KYC_APPROVED
  KYC_REJECTED
  ACTIVE
  SUSPENDED
  CHURNED

  @@schema("core")
}

enum TenantTier {
  STARTER
  GROWTH
  SCALE
  ENTERPRISE

  @@schema("core")
}

enum TenantType {
  PLATFORM // Umrah Connect itself — holds platform (Super Admin) accounts only
  OPERATOR // Licensed Umrah/Hajj operator
  MU_ASSASA // Saudi-licensed ground operator
  SUB_AGENT // Sub-agent under an operator
  VENDOR_HOTEL
  VENDOR_TRANSPORT
  VENDOR_CATERING
  VENDOR_GUIDE
  VENDOR_VISA

  @@schema("core")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  PENDING_VERIFICATION

  @@schema("core")
}

enum Gender {
  MALE
  FEMALE

  @@schema("core")
}

enum PilgrimStatus {
  LEAD
  PROSPECT
  BOOKED
  DOCUMENTS_PENDING
  VISA_PENDING
  VISA_APPROVED
  VISA_REJECTED
  TRAVELING
  IN_KINGDOM
  RETURNED
  CANCELLED

  @@schema("plugin_crm")
}

enum BookingStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_PAID
  FULLY_PAID
  VISA_PROCESSING
  TRAVELING
  COMPLETED
  CANCELLED
  REFUNDED

  @@schema("plugin_booking")
}

enum PaymentStatus {
  PENDING
  PROCESSING
  AUTHORIZED
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  DISPUTED

  @@schema("plugin_finance")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  VOID

  @@schema("plugin_finance")
}

enum VisaStatus {
  NOT_STARTED
  DOCUMENTS_COLLECTING
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED

  @@schema("plugin_visa")
}

enum RegulatorySystem {
  NUSUK_MASAR
  SISKOPATUH
  NAHCON
  DIYANET
  TABUNG_HAJI
  MOTAC
  IBA_DGRP
  MANUAL

  @@schema("plugin_visa")
}

enum HotelContractType {
  ALLOTMENT
  ON_DEMAND
  GUARANTEED

  @@schema("plugin_hotel")
}

enum TransportType {
  BUS_SMALL // Hiace/Coaster
  BUS_MEDIUM // 30-seat
  BUS_LARGE // 50-seat
  PRIVATE_CAR
  VAN

  @@schema("plugin_transport")
}

enum MovementType {
  AIRPORT_PICKUP
  AIRPORT_DROPOFF
  MAKKAH_MADINAH
  MADINAH_MAKKAH
  ZIYARAT
  MASHAER_MINA
  MASHAER_ARAFAT
  MASHAER_MUZDALIFAH
  LOCAL

  @@schema("plugin_transport")
}

enum VendorStatus {
  PENDING_KYC
  KYC_SUBMITTED
  VERIFIED
  SUSPENDED
  DELISTED

  @@schema("marketplace")
}

enum PostType {
  UPDATE
  OFFER
  GUIDELINE
  QUESTION
  PARTNERSHIP
  STORY
  EVENT

  @@schema("social")
}

enum PostVisibility {
  PUBLIC
  VERIFIED_ONLY
  ROLE_SET
  FOLLOWER_SET
  CUSTOM_SET

  @@schema("social")
}

enum ModerationStatus {
  PENDING
  APPROVED
  HELD_FOR_REVIEW
  REJECTED
  SHADOW_BANNED

  @@schema("social")
}

enum SocialAccountType {
  OPERATOR
  SUB_AGENT
  VENDOR_HOTEL
  VENDOR_TRANSPORT
  VENDOR_CATERING
  MUTAWIF
  VISA_PROCESSOR
  PILGRIM

  @@schema("social")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  SOFT_DELETE
  LOGIN
  LOGOUT
  PERMISSION_CHANGE
  TENANT_CONFIG_CHANGE
  PAYMENT_INITIATE
  PAYMENT_COMPLETE
  PAYMENT_FAIL
  VISA_SUBMIT
  VISA_STATUS_CHANGE
  DOCUMENT_UPLOAD
  DOCUMENT_DELETE
  DATA_EXPORT
  DATA_ACCESS

  @@schema("audit")
}

// ============================================================
// CORE SCHEMA — Tenant, User, RBAC
// ============================================================

model Tenant {
  id     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug   String       @unique @db.VarChar(100)
  name   String       @db.VarChar(255)
  nameAr String?      @map("name_ar") @db.VarChar(255)
  type   TenantType
  status TenantStatus @default(PENDING_KYC)
  tier   TenantTier   @default(STARTER)

  // Licensing
  licenseNumber    String?           @map("license_number") @db.VarChar(100)
  licenseCountry   String?           @map("license_country") @db.Char(2)
  licenseExpiry    DateTime?         @map("license_expiry") @db.Date
  regulatorySystem RegulatorySystem? @map("regulatory_system")

  // Contact
  email    String  @db.VarChar(255)
  phone    String? @db.VarChar(30)
  website  String? @db.VarChar(255)
  country  String  @db.Char(2)
  timezone String  @default("Asia/Riyadh") @db.VarChar(50)
  locale   String  @default("en") @db.VarChar(10)
  currency String  @default("SAR") @db.Char(3)

  // Hierarchy
  parentTenantId String?  @map("parent_tenant_id") @db.Uuid
  parentTenant   Tenant?  @relation("SubTenants", fields: [parentTenantId], references: [id])
  subTenants     Tenant[] @relation("SubTenants")

  // Metadata
  metadata  Json?     @db.JsonB
  settings  Json      @default("{}") @db.JsonB
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  // Relations
  users          User[]
  roles          Role[]
  kycRecords     TenantKyc[]
  pluginInstalls TenantPlugin[]

  @@map("tenants")
  @@schema("core")
}

model TenantKyc {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  registrySource   RegulatorySystem @map("registry_source")
  registryLookupAt DateTime?        @map("registry_lookup_at") @db.Timestamptz
  registryData     Json?            @map("registry_data") @db.JsonB
  verifiedAt       DateTime?        @map("verified_at") @db.Timestamptz
  verifiedBy       String?          @map("verified_by") @db.Uuid
  rejectionReason  String?          @map("rejection_reason")
  documents        Json             @default("[]") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("tenant_kyc")
  @@schema("core")
}

model User {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  email        String?    @db.VarChar(255)
  phone        String?    @db.VarChar(30)
  passwordHash String?    @map("password_hash")
  status       UserStatus @default(PENDING_VERIFICATION)

  // Profile
  firstName   String  @map("first_name") @db.VarChar(100)
  lastName    String  @map("last_name") @db.VarChar(100)
  firstNameAr String? @map("first_name_ar") @db.VarChar(100)
  lastNameAr  String? @map("last_name_ar") @db.VarChar(100)
  avatarUrl   String? @map("avatar_url")
  locale      String  @default("en") @db.VarChar(10)
  timezone    String  @default("Asia/Riyadh") @db.VarChar(50)

  // Auth
  mfaEnabled        Boolean   @default(false) @map("mfa_enabled")
  mfaSecret         String?   @map("mfa_secret")
  emailVerifiedAt   DateTime? @map("email_verified_at") @db.Timestamptz
  phoneVerifiedAt   DateTime? @map("phone_verified_at") @db.Timestamptz
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz
  lastLoginIp       String?   @map("last_login_ip")
  loginCount        Int       @default(0) @map("login_count")
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz
  // Access tokens issued before this instant are rejected (lock, force-logout, password change).
  sessionsRevokedAt DateTime? @map("sessions_revoked_at") @db.Timestamptz

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  createdBy  String?   @map("created_by") @db.Uuid
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz
  rowVersion Int       @default(1) @map("row_version")

  // Relations
  userRoles     UserRole[]
  refreshTokens RefreshToken[]
  otpCodes      OtpCode[]
  identities    UserIdentity[]
  socialAccount SocialAccount?
  pilgrimLinks  PilgrimAccountLink[] // eng100-a07
  preferences   UserPreference? // eng100-a02

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([email])
  @@map("users")
  @@schema("core")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")

  @@index([userId])
  @@map("refresh_tokens")
  @@schema("core")
}

/// External identity (e.g. Google) linked to a local account.
model UserIdentity {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String    @db.VarChar(30)
  providerSubject String    @map("provider_subject") @db.VarChar(255)
  email           String?   @db.VarChar(255)
  emailVerified   Boolean   @default(false) @map("email_verified")
  lastUsedAt      DateTime? @map("last_used_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("user_identities")
  @@schema("core")
}

model OtpCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String?
  email     String?
  codeHash  String    @map("code_hash")
  purpose   String    @db.VarChar(50) // phone_verify, login, password_reset
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  attempts  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([phone])
  @@index([email])
  @@map("otp_codes")
  @@schema("core")
}

/// eng100-a02 — per-user notification preferences (P07 / XT-005). Language and
/// time zone reuse User.locale and User.timezone.
model UserPreference {
  userId        String   @id @map("user_id") @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// { "inApp": { "<category>": false } } — only explicit opt-outs are stored; absent means on.
  notifications Json     @default("{}") @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("user_preferences")
  @@schema("core")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid // null = platform-wide role
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  name        String   @db.VarChar(100)
  description String?
  isSystem    Boolean  @default(false) @map("is_system") // platform-defined, not deletable
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  userRoles   UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@map("roles")
  @@schema("core")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Format: plugin:resource:action  e.g. crm:pilgrim:read
  namespace   String   @db.VarChar(50)
  resource    String   @db.VarChar(100)
  action      String   @db.VarChar(50)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  rolePermissions RolePermission[]

  @@unique([namespace, resource, action])
  @@map("permissions")
  @@schema("core")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedAt    DateTime   @default(now()) @map("granted_at") @db.Timestamptz
  grantedBy    String?    @map("granted_by") @db.Uuid

  @@id([roleId, permissionId])
  @@map("role_permissions")
  @@schema("core")
}

model UserRole {
  userId    String    @map("user_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  grantedAt DateTime  @default(now()) @map("granted_at") @db.Timestamptz
  grantedBy String?   @map("granted_by") @db.Uuid
  expiresAt DateTime? @map("expires_at") @db.Timestamptz

  @@id([userId, roleId])
  @@map("user_roles")
  @@schema("core")
}

model TenantPlugin {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  pluginId    String   @map("plugin_id") @db.VarChar(100)
  version     String   @db.VarChar(20)
  enabled     Boolean  @default(true)
  config      Json     @default("{}") @db.JsonB
  installedAt DateTime @default(now()) @map("installed_at") @db.Timestamptz
  installedBy String?  @map("installed_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([tenantId, pluginId])
  @@map("tenant_plugins")
  @@schema("core")
}

// ============================================================
// PLUGIN: CRM — Pilgrims, Leads, Family Groups
// ============================================================

model Pilgrim {
  id       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String        @map("tenant_id") @db.Uuid
  status   PilgrimStatus @default(LEAD)

  // Personal
  firstNameEn String   @map("first_name_en") @db.VarChar(100)
  lastNameEn  String   @map("last_name_en") @db.VarChar(100)
  firstNameAr String?  @map("first_name_ar") @db.VarChar(100)
  lastNameAr  String?  @map("last_name_ar") @db.VarChar(100)
  gender      Gender
  dateOfBirth DateTime @map("date_of_birth") @db.Date
  nationality String   @db.Char(2)

  // Contact
  email             String? @db.VarChar(255)
  phone             String? @db.VarChar(30)
  whatsapp          String? @db.VarChar(30)
  address           String?
  city              String? @db.VarChar(100)
  country           String  @db.Char(2)
  preferredLanguage String  @default("ar") @map("preferred_language") @db.VarChar(10)

  // Passport / ID
  passportNumber  String?   @map("passport_number") @db.VarChar(30) // encrypted
  passportExpiry  DateTime? @map("passport_expiry") @db.Date
  passportCountry String?   @map("passport_country") @db.Char(2)
  nationalId      String?   @map("national_id") @db.VarChar(30) // encrypted

  // Medical / accessibility
  hasDisability      Boolean @default(false) @map("has_disability")
  needsWheelchair    Boolean @default(false) @map("needs_wheelchair")
  medicalNotes       String? @map("medical_notes")
  vaccinated         Boolean @default(false)
  vaccinationRecords Json    @default("[]") @map("vaccination_records") @db.JsonB

  // CRM
  source     String?  @db.VarChar(100) // sub_agent_id, marketing_channel, referral
  subAgentId String?  @map("sub_agent_id") @db.Uuid
  notes      String?
  tags       String[]

  // Stats
  priorUmrahCount  Int    @default(0) @map("prior_umrah_count")
  priorHajjCount   Int    @default(0) @map("prior_hajj_count")
  lifetimeSpend    BigInt @default(0) @map("lifetime_spend") // minor units SAR
  lifetimeCurrency String @default("SAR") @map("lifetime_currency") @db.Char(3)

  // Family
  familyGroupId String?      @map("family_group_id") @db.Uuid
  familyGroup   FamilyGroup? @relation(fields: [familyGroupId], references: [id])
  mahramId      String?      @map("mahram_id") @db.Uuid // for female pilgrims

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  createdBy  String?   @map("created_by") @db.Uuid
  updatedBy  String?   @map("updated_by") @db.Uuid
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz
  rowVersion Int       @default(1) @map("row_version")

  documents PilgrimDocument[]
  accountLinks PilgrimAccountLink[] // eng100-a07

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, familyGroupId])
  @@map("pilgrims")
  @@schema("plugin_crm")
}

model FamilyGroup {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  name          String   @db.VarChar(200)
  leadPilgrimId String?  @map("lead_pilgrim_id") @db.Uuid
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  pilgrims Pilgrim[]

  @@index([tenantId])
  @@map("family_groups")
  @@schema("plugin_crm")
}

model PilgrimDocument {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  pilgrimId String  @map("pilgrim_id") @db.Uuid
  pilgrim   Pilgrim @relation(fields: [pilgrimId], references: [id], onDelete: Cascade)

  type          String    @db.VarChar(50) // passport, visa, vaccination, mahram_cert, photo
  fileName      String    @map("file_name")
  fileUrl       String    @map("file_url") // S3 key
  mimeType      String    @map("mime_type")
  fileSizeBytes Int       @map("file_size_bytes")
  ocrData       Json?     @map("ocr_data") @db.JsonB
  verified      Boolean   @default(false)
  verifiedAt    DateTime? @map("verified_at") @db.Timestamptz
  verifiedBy    String?   @map("verified_by") @db.Uuid
  expiresAt     DateTime? @map("expires_at") @db.Date
  version       Int       @default(1)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy String?  @map("created_by") @db.Uuid

  @@index([tenantId, pilgrimId])
  @@map("pilgrim_documents")
  @@schema("plugin_crm")
}

// eng100-a07 — traveler ↔ pilgrim linkage (P06 / XT-003, DECISIONS.md D-022)
enum PilgrimLinkStatus {
  INVITED // invitation emailed, waiting for the traveler
  ACTIVE // accepted by the verified traveler account the invitation was sent to
  DECLINED // the traveler declined the invitation
  REVOKED // the organization withdrew the invitation or ended the link
  UNLINKED // the traveler ended an active link
  EXPIRED // the invitation passed its expiry unused

  @@schema("plugin_crm")
}

/// An organization-initiated, traveler-accepted relationship between ONE traveler
/// account and ONE pilgrim record of ONE organization. It is the only way a
/// traveler account can see organization data about a pilgrim record, and it
/// only ever exposes that record's trip status — never organization-wide reads.
/// Nothing is linked because an email, name or phone happens to match.
///
/// Integrity rules that Prisma 5 cannot express live in the migration
/// 20260918170000_pilgrim_account_links (Prisma's diff ignores them, so they do
/// not show up as drift):
///   - partial unique index: at most one ACTIVE link per pilgrim record (which
///     also means an account can never hold two ACTIVE links to one record);
///   - partial unique index: at most one outstanding INVITED invitation per record;
///   - CHECK: an ACTIVE link has an account and an acceptance time;
///   - CHECK: an INVITED link has a token hash.
model PilgrimAccountLink {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The organization that holds the pilgrim record (and invited the traveler).
  tenantId  String            @map("tenant_id") @db.Uuid
  pilgrimId String            @map("pilgrim_id") @db.Uuid
  pilgrim   Pilgrim           @relation(fields: [pilgrimId], references: [id], onDelete: Cascade)
  /// The traveler account — set only when the invitation is accepted.
  userId    String?           @map("user_id") @db.Uuid
  user      User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    PilgrimLinkStatus @default(INVITED)

  /// Lower-cased address the invitation was sent to. Acceptance requires the
  /// accepting account's verified email to be exactly this address.
  invitedEmail String  @map("invited_email") @db.VarChar(255)
  /// RECORD = the pilgrim's email on file; ENTERED = typed by the inviting staff member.
  emailSource  String  @default("RECORD") @map("email_source") @db.VarChar(20)
  /// SHA-256 (hex) of the single-use invitation token. The raw token exists only
  /// in the emailed link; the hash is cleared as soon as the invitation is answered.
  tokenHash    String? @unique @map("token_hash") @db.VarChar(64)

  invitedBy     String    @map("invited_by") @db.Uuid
  invitedAt     DateTime  @default(now()) @map("invited_at") @db.Timestamptz
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz
  lastSentAt    DateTime  @default(now()) @map("last_sent_at") @db.Timestamptz
  sendCount     Int       @default(1) @map("send_count")
  acceptedAt    DateTime? @map("accepted_at") @db.Timestamptz
  declinedAt    DateTime? @map("declined_at") @db.Timestamptz
  unlinkedAt    DateTime? @map("unlinked_at") @db.Timestamptz
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz
  revokedBy     String?   @map("revoked_by") @db.Uuid
  revokedReason String?   @map("revoked_reason") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([tenantId, pilgrimId])
  @@index([userId, status])
  @@map("pilgrim_account_links")
  @@schema("plugin_crm")
}

// ============================================================
// PLUGIN: BOOKING — Packages, Bookings, Payments
// ============================================================

model Package {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  name          String  @db.VarChar(255)
  nameAr        String? @map("name_ar") @db.VarChar(255)
  description   String?
  descriptionAr String? @map("description_ar")
  tier          String  @default("STANDARD") @db.VarChar(50) // ECONOMY/STANDARD/PREMIUM/VIP
  tripType      String  @db.VarChar(20) // UMRAH / HAJJ
  durationDays  Int     @map("duration_days")

  // Travel dates
  departureDate DateTime? @map("departure_date") @db.Date
  returnDate    DateTime? @map("return_date") @db.Date

  // Pricing (bigint minor units)
  basePriceCents BigInt @map("base_price_cents")
  currency       String @default("SAR") @db.Char(3)
  maxCapacity    Int    @map("max_capacity")
  bookedCount    Int    @default(0) @map("booked_count")

  // Composition (services included)
  includes     Json @default("{}") @db.JsonB // visa, flight, hotel_makkah, hotel_madinah, transport, meals, guide
  pricingRules Json @default("[]") @db.JsonB // seasonal multipliers, early-bird discounts

  isPublished Boolean   @default(false) @map("is_published")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  createdBy   String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  bookings Booking[]

  @@index([tenantId])
  @@map("packages")
  @@schema("plugin_booking")
}

model Booking {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String        @map("tenant_id") @db.Uuid
  bookingRef String        @unique @map("booking_ref") // UC-2026-00001
  packageId  String?       @map("package_id") @db.Uuid
  package    Package?      @relation(fields: [packageId], references: [id])
  status     BookingStatus @default(DRAFT)

  // Origination
  subAgentId             String?  @map("sub_agent_id") @db.Uuid
  subAgentCommissionRate Decimal? @map("sub_agent_commission_rate") @db.Decimal(5, 2)

  // Pricing snapshot (at time of booking)
  totalAmountCents BigInt @map("total_amount_cents")
  paidAmountCents  BigInt @default(0) @map("paid_amount_cents")
  currency         String @default("SAR") @db.Char(3)
  discountCents    BigInt @default(0) @map("discount_cents")
  taxCents         BigInt @default(0) @map("tax_cents")

  // Travel
  groupId       String?   @map("group_id") @db.Uuid
  departureDate DateTime? @map("departure_date") @db.Date
  returnDate    DateTime? @map("return_date") @db.Date
  flightDetails Json?     @map("flight_details") @db.JsonB

  notes              String?
  cancellationReason String?   @map("cancellation_reason")
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz

  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy  String?  @map("created_by") @db.Uuid
  updatedBy  String?  @map("updated_by") @db.Uuid
  rowVersion Int      @default(1) @map("row_version")

  pilgrims BookingPilgrim[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([bookingRef])
  @@map("bookings")
  @@schema("plugin_booking")
}

model BookingPilgrim {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  bookingId String  @map("booking_id") @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id])
  pilgrimId String  @map("pilgrim_id") @db.Uuid

  // Per-pilgrim pricing override
  priceCents  BigInt? @map("price_cents")
  currency    String? @db.Char(3)
  roomType    String? @map("room_type") @db.VarChar(50)
  bedType     String? @map("bed_type") @db.VarChar(30)
  seatNumber  String? @map("seat_number") @db.VarChar(20)
  mealPref    String? @map("meal_pref") @db.VarChar(50)
  specialReqs String? @map("special_reqs")

  addedAt DateTime @default(now()) @map("added_at") @db.Timestamptz

  @@unique([bookingId, pilgrimId])
  @@index([tenantId])
  @@map("booking_pilgrims")
  @@schema("plugin_booking")
}

// ============================================================
// PLUGIN: HOTEL INVENTORY
// ============================================================

model Hotel {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String? @map("tenant_id") @db.Uuid // null = marketplace-wide
  vendorId String? @map("vendor_id") @db.Uuid

  name            String   @db.VarChar(255)
  nameAr          String?  @map("name_ar") @db.VarChar(255)
  city            String   @db.VarChar(100) // MAKKAH / MADINAH / JEDDAH
  country         String   @default("SA") @db.Char(2)
  area            String?  @db.VarChar(120) // district / neighbourhood
  address         String?
  postalCode      String?  @map("postal_code") @db.VarChar(20)
  starRating      Int?     @map("star_rating")
  distanceToHaram Int?     @map("distance_to_haram") // meters
  coordinates     Json?    @db.JsonB
  amenities       String[]
  images          String[]
  description     String?
  descriptionAr   String?  @map("description_ar")

  // Contact + operations
  contactPerson      String? @map("contact_person") @db.VarChar(150)
  phone              String? @db.VarChar(40)
  email              String? @db.VarChar(255)
  checkInTime        String? @map("check_in_time") @db.VarChar(10) // "15:00"
  checkOutTime       String? @map("check_out_time") @db.VarChar(10) // "12:00"
  cancellationPolicy String? @map("cancellation_policy")
  totalRooms         Int     @default(0) @map("total_rooms")
  status             String  @default("ACTIVE") @db.VarChar(20) // ACTIVE / INACTIVE / MAINTENANCE
  notes              String?
  isVerified         Boolean @default(false) @map("is_verified")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  roomTypes     RoomType[]
  allotments    Allotment[]
  rooms         Room[]
  hotelBookings HotelBooking[]

  @@index([tenantId])
  @@index([city])
  @@index([tenantId, status])
  @@map("hotels")
  @@schema("plugin_hotel")
}

model RoomType {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId             String   @map("hotel_id") @db.Uuid
  hotel               Hotel    @relation(fields: [hotelId], references: [id])
  name                String   @db.VarChar(100)
  occupancy           Int // 1=single, 2=double, 3=triple, 4=quad
  bedConfig           String?  @map("bed_config") @db.VarChar(50)
  description         String?
  basePriceCents      BigInt   @default(0) @map("base_price_cents") // per room per night
  pricePerPersonCents BigInt?  @map("price_per_person_cents")
  totalCount          Int      @default(0) @map("total_count") // number of rooms of this type
  status              String   @default("ACTIVE") @db.VarChar(20)
  amenities           String[]
  images              String[]

  rooms Room[]

  @@index([hotelId])
  @@map("room_types")
  @@schema("plugin_hotel")
}

model Room {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  hotelId             String    @map("hotel_id") @db.Uuid
  hotel               Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomTypeId          String?   @map("room_type_id") @db.Uuid
  roomType            RoomType? @relation(fields: [roomTypeId], references: [id])
  roomNumber          String    @map("room_number") @db.VarChar(40)
  floor               String?   @db.VarChar(20)
  capacity            Int       @default(2)
  bedType             String?   @map("bed_type") @db.VarChar(40)
  bedCount            Int       @default(1) @map("bed_count")
  availableBeds       Int       @default(0) @map("available_beds")
  pricePerNightCents  BigInt    @default(0) @map("price_per_night_cents")
  pricePerPersonCents BigInt?   @map("price_per_person_cents")
  seasonalPricing     Json      @default("[]") @map("seasonal_pricing") @db.JsonB
  images              String[]
  facilities          String[]
  description         String?
  status              String    @default("AVAILABLE") @db.VarChar(20) // AVAILABLE / OCCUPIED / MAINTENANCE / INACTIVE
  notes               String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([hotelId])
  @@index([hotelId, status])
  @@map("rooms")
  @@schema("plugin_hotel")
}

model HotelBooking {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  hotelId    String  @map("hotel_id") @db.Uuid
  hotel      Hotel   @relation(fields: [hotelId], references: [id])
  roomTypeId String? @map("room_type_id") @db.Uuid
  roomId     String? @map("room_id") @db.Uuid

  // Guest — platform user OR external
  customerUserId   String? @map("customer_user_id") @db.Uuid
  guestName        String  @map("guest_name") @db.VarChar(200)
  guestEmail       String? @map("guest_email") @db.VarChar(255)
  guestPhone       String? @map("guest_phone") @db.VarChar(40)
  guestNationality String? @map("guest_nationality") @db.Char(2)
  source           String  @default("EXTERNAL") @db.VarChar(20) // PLATFORM_USER / EXTERNAL / OPERATOR / MARKETPLACE

  checkIn          DateTime @map("check_in") @db.Date
  checkOut         DateTime @map("check_out") @db.Date
  guests           Int      @default(1)
  totalAmountCents BigInt   @default(0) @map("total_amount_cents")
  currency         String   @default("SAR") @db.VarChar(8)
  status           String   @default("PENDING") @db.VarChar(20) // PENDING / CONFIRMED / CHECKED_IN / CHECKED_OUT / COMPLETED / CANCELLED
  paymentStatus    String   @default("UNPAID") @map("payment_status") @db.VarChar(20) // UNPAID / PARTIAL / PAID / REFUNDED
  notes            String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([tenantId])
  @@index([hotelId, status])
  @@index([tenantId, checkIn])
  @@map("hotel_bookings")
  @@schema("plugin_hotel")
}

model Allotment {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  hotelId      String            @map("hotel_id") @db.Uuid
  hotel        Hotel             @relation(fields: [hotelId], references: [id])
  roomTypeId   String?           @map("room_type_id") @db.Uuid
  contractType HotelContractType @default(ALLOTMENT) @map("contract_type")

  checkIn        DateTime @map("check_in") @db.Date
  checkOut       DateTime @map("check_out") @db.Date
  totalRooms     Int      @map("total_rooms")
  bookedRooms    Int      @default(0) @map("booked_rooms")
  overbookBuffer Int      @default(0) @map("overbook_buffer")

  // Pricing
  rateCents          BigInt @map("rate_cents") // per room per night
  currency           String @default("SAR") @db.Char(3)
  cancellationPolicy Json   @default("{}") @map("cancellation_policy") @db.JsonB

  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  roomAssignments RoomAssignment[]

  @@index([tenantId])
  @@index([tenantId, checkIn, checkOut])
  @@map("allotments")
  @@schema("plugin_hotel")
}

model RoomAssignment {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  allotmentId String    @map("allotment_id") @db.Uuid
  allotment   Allotment @relation(fields: [allotmentId], references: [id])
  bookingId   String    @map("booking_id") @db.Uuid
  roomNumber  String?   @map("room_number") @db.VarChar(20)
  pilgrims    Json      @default("[]") @db.JsonB // pilgrim IDs
  checkIn     DateTime  @map("check_in") @db.Date
  checkOut    DateTime  @map("check_out") @db.Date
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz

  @@index([tenantId])
  @@index([allotmentId])
  @@map("room_assignments")
  @@schema("plugin_hotel")
}

// ============================================================
// PLUGIN: VISA & COMPLIANCE
// ============================================================

model VisaApplication {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  pilgrimId  String? @map("pilgrim_id") @db.Uuid
  bookingId  String? @map("booking_id") @db.Uuid
  operatorId String? @map("operator_id") @db.Uuid // operator who submitted on behalf

  status           VisaStatus       @default(NOT_STARTED)
  regulatorySystem RegulatorySystem @map("regulatory_system")

  // Applicant snapshot (external applicants who are not platform pilgrims)
  applicantName        String? @map("applicant_name") @db.VarChar(200)
  applicantPassport    String? @map("applicant_passport") @db.VarChar(50)
  applicantNationality String? @map("applicant_nationality") @db.Char(2)

  // Visa service detail
  visaType             String?   @map("visa_type") @db.VarChar(50)
  destinationCountry   String?   @map("destination_country") @db.Char(2)
  serviceCountry       String?   @map("service_country") @db.Char(2)
  applicationNumber    String?   @map("application_number") @db.VarChar(60)
  requiredDocuments    String[]  @map("required_documents")
  assignedOfficer      String?   @map("assigned_officer") @db.VarChar(150)
  expectedCompletionAt DateTime? @map("expected_completion_at") @db.Date

  // Finance
  priceCents    BigInt @default(0) @map("price_cents")
  currency      String @default("SAR") @db.VarChar(8)
  paymentStatus String @default("UNPAID") @map("payment_status") @db.VarChar(20)

  submittedAt DateTime? @map("submitted_at") @db.Timestamptz
  approvedAt  DateTime? @map("approved_at") @db.Timestamptz
  rejectedAt  DateTime? @map("rejected_at") @db.Timestamptz
  expiresAt   DateTime? @map("expires_at") @db.Date

  // Regulator response
  externalRef     String? @map("external_ref") @db.VarChar(100) // Nusuk/SISKOPATUH ref
  regulatorData   Json?   @map("regulator_data") @db.JsonB
  rejectionCode   String? @map("rejection_code") @db.VarChar(50)
  rejectionReason String? @map("rejection_reason")
  riskScore       Int?    @map("risk_score") // AI-computed visa rejection risk

  documents Json    @default("[]") @db.JsonB
  timeline  Json    @default("[]") @db.JsonB // immutable event log
  notes     String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy String?  @map("created_by") @db.Uuid

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([pilgrimId])
  @@map("visa_applications")
  @@schema("plugin_visa")
}

model RegulatorySubmission {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  regulatorySystem RegulatorySystem @map("regulatory_system")
  batchRef         String?          @map("batch_ref") @db.VarChar(100)
  pilgrimIds       String[]         @map("pilgrim_ids")

  submittedAt    DateTime? @map("submitted_at") @db.Timestamptz
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz
  completedAt    DateTime? @map("completed_at") @db.Timestamptz
  failedAt       DateTime? @map("failed_at") @db.Timestamptz

  requestPayload  Json? @map("request_payload") @db.JsonB
  responsePayload Json? @map("response_payload") @db.JsonB
  errorDetails    Json? @map("error_details") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId])
  @@index([tenantId, regulatorySystem])
  @@map("regulatory_submissions")
  @@schema("plugin_visa")
}

// ─── Visa service requests (support ticket workflow) ────────────────────
enum VisaRequestCategory {
  NEW_APPLICATION
  DOCUMENT_ISSUE
  STATUS_INQUIRY
  URGENT_PROCESSING
  APPOINTMENT
  CORRECTION
  REFUND
  CANCELLATION
  OTHER

  @@schema("plugin_visa")
}

enum VisaRequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@schema("plugin_visa")
}

enum VisaRequestStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  ESCALATED
  RESOLVED
  CLOSED

  @@schema("plugin_visa")
}

enum VisaRequestNoteVisibility {
  INTERNAL
  PUBLIC

  @@schema("plugin_visa")
}

model VisaServiceRequest {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  ticketNumber String @map("ticket_number") @db.VarChar(30)

  subject     String              @db.VarChar(200)
  description String?
  category    VisaRequestCategory @default(OTHER)
  priority    VisaRequestPriority @default(NORMAL)
  status      VisaRequestStatus   @default(OPEN)

  // Who raised it (pilgrim / operator contact — not necessarily a platform user)
  requesterName  String? @map("requester_name") @db.VarChar(150)
  requesterEmail String? @map("requester_email") @db.VarChar(255)
  requesterPhone String? @map("requester_phone") @db.VarChar(30)
  requesterId    String? @map("requester_id") @db.Uuid

  // Optional links into the visa domain
  pilgrimId         String? @map("pilgrim_id") @db.Uuid
  visaApplicationId String? @map("visa_application_id") @db.Uuid

  assigneeId   String? @map("assignee_id") @db.Uuid
  assigneeName String? @map("assignee_name") @db.VarChar(150)

  dueAt            DateTime? @map("due_at") @db.Timestamptz
  firstResponseAt  DateTime? @map("first_response_at") @db.Timestamptz
  escalatedAt      DateTime? @map("escalated_at") @db.Timestamptz
  escalationReason String?   @map("escalation_reason")
  resolvedAt       DateTime? @map("resolved_at") @db.Timestamptz
  resolution       String?
  closedAt         DateTime? @map("closed_at") @db.Timestamptz
  reopenedAt       DateTime? @map("reopened_at") @db.Timestamptz
  reopenCount      Int       @default(0) @map("reopen_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy String?  @map("created_by") @db.Uuid

  notes  VisaServiceRequestNote[]
  events VisaServiceRequestEvent[]

  @@unique([tenantId, ticketNumber])
  @@index([tenantId, status])
  @@index([tenantId, assigneeId])
  @@index([tenantId, dueAt])
  @@map("visa_service_requests")
  @@schema("plugin_visa")
}

model VisaServiceRequestNote {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId String             @map("request_id") @db.Uuid
  request   VisaServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  visibility VisaRequestNoteVisibility @default(INTERNAL)
  body       String
  authorId   String?                   @map("author_id") @db.Uuid
  authorName String?                   @map("author_name") @db.VarChar(150)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([requestId, createdAt])
  @@map("visa_service_request_notes")
  @@schema("plugin_visa")
}

model VisaServiceRequestEvent {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId String             @map("request_id") @db.Uuid
  request   VisaServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  type       String  @db.VarChar(40) // CREATED | STATUS_CHANGED | ASSIGNED | ...
  message    String  @db.VarChar(400)
  fromValue  String? @map("from_value") @db.VarChar(100)
  toValue    String? @map("to_value") @db.VarChar(100)
  actorId    String? @map("actor_id") @db.Uuid
  actorEmail String? @map("actor_email") @db.VarChar(255)
  metadata   Json?   @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([requestId, createdAt])
  @@map("visa_service_request_events")
  @@schema("plugin_visa")
}

// ─── Visa document management (versioned, auditable) ────────────────────
enum VisaDocumentStatus {
  MISSING
  RECEIVED
  VERIFIED
  REJECTED
  EXPIRED

  @@schema("plugin_visa")
}

model VisaDocument {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  applicationId String @map("application_id") @db.Uuid

  name   String             @db.VarChar(200)
  type   String             @default("OTHER") @db.VarChar(60)
  status VisaDocumentStatus @default(MISSING)

  /// Current version's stored location, denormalised for list views.
  url       String?
  mimeType  String? @map("mime_type") @db.VarChar(120)
  sizeBytes Int?    @map("size_bytes")
  version   Int     @default(0)

  expiresAt       DateTime? @map("expires_at") @db.Date
  verifiedAt      DateTime? @map("verified_at") @db.Timestamptz
  verifiedBy      String?   @map("verified_by") @db.Uuid
  rejectedAt      DateTime? @map("rejected_at") @db.Timestamptz
  rejectionReason String?   @map("rejection_reason")
  notes           String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy String?  @map("created_by") @db.Uuid

  versions VisaDocumentVersion[]

  @@index([tenantId, applicationId])
  @@index([tenantId, status])
  @@index([tenantId, expiresAt])
  @@map("visa_documents")
  @@schema("plugin_visa")
}

model VisaDocumentVersion {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId String       @map("document_id") @db.Uuid
  document   VisaDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  version    Int
  url        String
  storageKey String? @map("storage_key")
