  @@schema("plugin_group_ops")
}

model GroupDocument {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId     String   @map("group_id") @db.Uuid
  uploaderId  String   @map("uploader_id") @db.Uuid
  name        String   @db.VarChar(255)
  url         String
  mimeType    String?  @map("mime_type") @db.VarChar(120)
  sizeBytes   Int?     @map("size_bytes")
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([groupId, createdAt(sort: Desc)])
  @@map("group_documents")
  @@schema("plugin_group_ops")
}

model Incident {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  groupId     String    @map("group_id") @db.Uuid
  group       TripGroup @relation(fields: [groupId], references: [id])
  pilgrimId   String?   @map("pilgrim_id") @db.Uuid
  type        String    @db.VarChar(50) // MEDICAL, LOST, DELAY, COMPLAINT, OTHER
  severity    String    @db.VarChar(20) // LOW, MEDIUM, HIGH, CRITICAL
  description String
  location    String?
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz
  resolution  String?
  reportedBy  String?   @map("reported_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, groupId])
  @@map("incidents")
  @@schema("plugin_group_ops")
}

// ============================================================
// MARKETPLACE SCHEMA
// ============================================================

model Vendor {
  id       String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String?      @map("tenant_id") @db.Uuid // if linked to a tenant
  status   VendorStatus @default(PENDING_KYC)
  type     TenantType // VENDOR_HOTEL / VENDOR_TRANSPORT / etc.

  name        String  @db.VarChar(255)
  nameAr      String? @map("name_ar") @db.VarChar(255)
  description String?
  email       String  @db.VarChar(255)
  phone       String? @db.VarChar(30)
  website     String?
  country     String  @db.Char(2)
  city        String? @db.VarChar(100)
  address     String?

  kycDocuments Json      @default("[]") @map("kyc_documents") @db.JsonB
  verifiedAt   DateTime? @map("verified_at") @db.Timestamptz
  verifiedBy   String?   @map("verified_by") @db.Uuid
  rating       Decimal?  @db.Decimal(3, 2)
  ratingCount  Int       @default(0) @map("rating_count")

  logoUrl String?  @map("logo_url")
  images  String[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  listings Listing[]
  ratings  VendorRating[]
  quotes   Quote[]

  @@index([status])
  @@index([type])
  @@map("vendors")
  @@schema("marketplace")
}

model Listing {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId     String   @map("vendor_id") @db.Uuid
  vendor       Vendor   @relation(fields: [vendorId], references: [id])
  type         String   @db.VarChar(50) // hotel_room, transport_service, guide, catering, visa_service
  name         String   @db.VarChar(255)
  nameAr       String?  @map("name_ar") @db.VarChar(255)
  description  String?
  priceCents   BigInt   @map("price_cents")
  currency     String   @default("SAR") @db.Char(3)
  pricingModel String   @default("PER_PERSON") @db.VarChar(30) // PER_PERSON / PER_GROUP / PER_NIGHT
  attributes   Json     @default("{}") @db.JsonB
  imageUrls    String[] @map("image_urls")
  status       String   @default("PUBLISHED") @db.VarChar(20) // DRAFT / PUBLISHED / PAUSED / ARCHIVED
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  quotes    Quote[]
  inquiries ListingInquiry[]
  bookings  ListingBooking[]

  city String? @db.VarChar(100) // eng100-a06: mirrors attributes.city so the marketplace can filter by city

  @@index([vendorId])
  @@index([type, status])
  @@index([status, isActive, createdAt]) // eng100-a06: public catalogue scans
  @@map("listings")
  @@schema("marketplace")
}

model ListingInquiry {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId   String    @map("listing_id") @db.Uuid
  listing     Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  fromUserId  String?   @map("from_user_id") @db.Uuid
  fromName    String?   @map("from_name") @db.VarChar(200)
  fromEmail   String?   @map("from_email") @db.VarChar(255)
  fromPhone   String?   @map("from_phone") @db.VarChar(40)
  message     String
  partySize   Int?      @map("party_size")
  startDate   DateTime? @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  status      String    @default("NEW") @db.VarChar(20) // NEW / RESPONDED / CONVERTED / CLOSED
  response    String?
  respondedAt DateTime? @map("responded_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([listingId, status])
  @@index([fromUserId])
  @@map("listing_inquiries")
  @@schema("marketplace")
}

model ListingBooking {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId        String    @map("listing_id") @db.Uuid
  listing          Listing   @relation(fields: [listingId], references: [id])
  customerUserId   String?   @map("customer_user_id") @db.Uuid
  customerName     String    @map("customer_name") @db.VarChar(200)
  customerEmail    String?   @map("customer_email") @db.VarChar(255)
  customerPhone    String?   @map("customer_phone") @db.VarChar(40)
  startDate        DateTime? @map("start_date") @db.Date
  endDate          DateTime? @map("end_date") @db.Date
  partySize        Int       @default(1) @map("party_size")
  totalAmountCents BigInt    @default(0) @map("total_amount_cents")
  currency         String    @default("SAR") @db.VarChar(8)
  status           String    @default("PENDING") @db.VarChar(20) // PENDING / CONFIRMED / PAID / COMPLETED / CANCELLED / REFUNDED
  paymentStatus    String    @default("UNPAID") @map("payment_status") @db.VarChar(20) // UNPAID / PARTIAL / PAID / REFUNDED
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([listingId, status])
  @@index([customerUserId])
  @@map("listing_bookings")
  @@schema("marketplace")
}

model Quote {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid // requesting operator
  vendorId  String   @map("vendor_id") @db.Uuid
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  listingId String?  @map("listing_id") @db.Uuid
  listing   Listing? @relation(fields: [listingId], references: [id])

  status            String    @default("PENDING") @db.VarChar(30) // PENDING, OFFERED, ACCEPTED, REJECTED, EXPIRED
  requirements      Json      @default("{}") @db.JsonB
  offeredPriceCents BigInt?   @map("offered_price_cents")
  currency          String    @default("SAR") @db.Char(3)
  validUntil        DateTime? @map("valid_until") @db.Timestamptz

  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamptz
  respondedAt DateTime? @map("responded_at") @db.Timestamptz
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz
  rejectedAt  DateTime? @map("rejected_at") @db.Timestamptz
  notes       String?

  @@index([tenantId])
  @@index([vendorId])
  @@map("quotes")
  @@schema("marketplace")
}

model VendorRating {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId   String   @map("vendor_id") @db.Uuid
  vendor     Vendor   @relation(fields: [vendorId], references: [id])
  tenantId   String   @map("tenant_id") @db.Uuid // rating operator
  bookingRef String?  @map("booking_ref")
  score      Int // 1-5
  review     String?
  isVerified Boolean  @default(false) @map("is_verified") // only operators with completed bookings
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([vendorId, tenantId, bookingRef])
  @@map("vendor_ratings")
  @@schema("marketplace")
}

// eng100-a06: registry of public media written by POST /uploads. It records who
// uploaded each object so only the uploader can delete it, and so listing images
// can be restricted to media the caller's organization actually uploaded. It is
// not a reference: the orphan cleanup job ignores this table when deciding
// whether an object is still in use.
model MediaObject {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String?   @map("tenant_id") @db.Uuid
  ownerUserId  String    @map("owner_user_id") @db.Uuid
  storageKey   String    @unique @map("storage_key") @db.VarChar(512)
  url          String
  driver       String    @db.VarChar(20)
  visibility   String    @default("public") @db.VarChar(20)
  mimeType     String    @map("mime_type") @db.VarChar(120)
  sizeBytes    Int       @map("size_bytes")
  checksum     String    @db.VarChar(64)
  originalName String?   @map("original_name") @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  @@index([ownerUserId, createdAt])
  @@index([tenantId])
  @@map("media_objects")
  @@schema("core")
}

// ============================================================
// SOCIAL SCHEMA — Cross-tenant feed (no tenant_id RLS here)
// ============================================================

model SocialAccount {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String            @unique @map("user_id") @db.Uuid
  user           User              @relation(fields: [userId], references: [id])
  type           SocialAccountType
  displayName    String            @map("display_name") @db.VarChar(100)
  bio            String?
  avatarUrl      String?           @map("avatar_url")
  isVerified     Boolean           @default(false) @map("is_verified")
  verifiedBadge  String?           @map("verified_badge") // operator, vendor, guide
  privacyDefault PostVisibility    @default(PUBLIC) @map("privacy_default")
  coverUrl       String?           @map("cover_url")

  // Traveler profile fields
  phone             String?   @db.VarChar(40)
  nationality       String?   @db.Char(2)
  city              String?   @db.VarChar(100)
  travelInterests   String[]  @map("travel_interests") // ["UMRAH", "HAJJ", "FAMILY_TRIP", ...]
  preferredDateFrom DateTime? @map("preferred_date_from") @db.Date
  preferredDateTo   DateTime? @map("preferred_date_to") @db.Date
  profileVisibility String    @default("PUBLIC") @map("profile_visibility") @db.VarChar(20) // PUBLIC / CONNECTIONS / PRIVATE
  contactVisibility String    @default("CONNECTIONS") @map("contact_visibility") @db.VarChar(20) // PUBLIC / CONNECTIONS / PRIVATE

  followerCount  Int      @default(0) @map("follower_count")
  followingCount Int      @default(0) @map("following_count")
  postCount      Int      @default(0) @map("post_count")
  isSuspended    Boolean  @default(false) @map("is_suspended")
  isShadowBanned Boolean  @default(false) @map("is_shadow_banned")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  posts         Post[]
  comments      Comment[]
  reactions     Reaction[]
  followingList Follow[]     @relation("Follower")
  followerList  Follow[]     @relation("Followed")
  sentMessages  Message[]
  postReports   PostReport[]
  savedPosts    SavedPost[]

  @@map("social_accounts")
  @@schema("social")
}

model SavedPost {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String        @map("account_id") @db.Uuid
  account   SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  postId    String        @map("post_id") @db.Uuid
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  savedAt   DateTime      @default(now()) @map("saved_at") @db.Timestamptz

  @@unique([accountId, postId])
  @@index([accountId, savedAt(sort: Desc)])
  @@map("saved_posts")
  @@schema("social")
}

model Post {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId         String           @map("author_id") @db.Uuid
  author           SocialAccount    @relation(fields: [authorId], references: [id])
  type             PostType
  visibility       PostVisibility   @default(PUBLIC)
  moderationStatus ModerationStatus @default(PENDING) @map("moderation_status")

  // Content
  body           String?  @db.VarChar(2000)
  structuredData Json?    @map("structured_data") @db.JsonB // offer/guideline/event fields
  mediaUrls      String[] @map("media_urls")
  attachmentUrl  String?  @map("attachment_url") // PDF for guidelines
  tags           String[]
  language       String   @default("ar") @db.VarChar(10)

  // Expiry (for offers, stories)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz

  // Engagement counts (denormalized for perf)
  likeCount    Int @default(0) @map("like_count")
  commentCount Int @default(0) @map("comment_count")
  shareCount   Int @default(0) @map("share_count")
  saveCount    Int @default(0) @map("save_count")

  // Source
  sourceCountry String?  @map("source_country") @db.Char(2)
  targetRoles   String[] @map("target_roles") // for role-set visibility

  // Moderation
  moderatedAt     DateTime? @map("moderated_at") @db.Timestamptz
  moderatedBy     String?   @map("moderated_by") @db.Uuid
  moderationNotes String?   @map("moderation_notes")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  comments  Comment[]
  reactions Reaction[]
  reports   PostReport[]
  savedBy   SavedPost[]
  editedAt  DateTime?    @map("edited_at") @db.Timestamptz // eng100-a05: set when the author edits the content

  @@index([authorId])
  @@index([type, moderationStatus])
  @@index([createdAt])
  @@map("posts")
  @@schema("social")
}

model Comment {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId           String           @map("post_id") @db.Uuid
  post             Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId         String           @map("author_id") @db.Uuid
  author           SocialAccount    @relation(fields: [authorId], references: [id])
  parentId         String?          @map("parent_id") @db.Uuid
  body             String           @db.VarChar(1000)
  likeCount        Int              @default(0) @map("like_count")
  moderationStatus ModerationStatus @default(APPROVED) @map("moderation_status")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz

  reactions Reaction[]
  editedAt  DateTime?  @map("edited_at") @db.Timestamptz // eng100-a05: set when the author edits the comment

  @@index([postId])
  @@index([authorId])
  @@index([postId, parentId, createdAt]) // eng100-a05: paginated top-level comments and reply threads
  @@map("comments")
  @@schema("social")
}

model Reaction {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String        @map("account_id") @db.Uuid
  account   SocialAccount @relation(fields: [accountId], references: [id])
  postId    String?       @map("post_id") @db.Uuid
  post      Post?         @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId String?       @map("comment_id") @db.Uuid
  comment   Comment?      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  type      String        @default("LIKE") @db.VarChar(20) // LIKE, SAVE, SHARE
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@unique([accountId, postId, type])
  @@unique([accountId, commentId, type])
  @@map("reactions")
  @@schema("social")
}

model Follow {
  followerId String        @map("follower_id") @db.Uuid
  followedId String        @map("followed_id") @db.Uuid
  follower   SocialAccount @relation("Follower", fields: [followerId], references: [id])
  followed   SocialAccount @relation("Followed", fields: [followedId], references: [id])
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@id([followerId, followedId])
  @@map("follows")
  @@schema("social")
}

model Conversation {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          String    @default("DM") @db.VarChar(20) // DM, GROUP, BOOKING_THREAD, TRIP_THREAD
  name          String?   @db.VarChar(200)
  contextRef    String?   @map("context_ref") @db.VarChar(100) // booking_id, trip_id
  participants  Json      @default("[]") @db.JsonB // account IDs
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  messages Message[]

  @@map("conversations")
  @@schema("social")
}

model Message {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String        @map("conversation_id") @db.Uuid
  conversation   Conversation  @relation(fields: [conversationId], references: [id])
  senderId       String        @map("sender_id") @db.Uuid
  sender         SocialAccount @relation(fields: [senderId], references: [id])
  body           String        @db.VarChar(4000)
  mediaUrls      String[]      @map("media_urls")
  readBy         Json          @default("[]") @map("read_by") @db.JsonB // [{account_id, read_at}]
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@index([conversationId, createdAt])
  @@map("messages")
  @@schema("social")
}

model PostReport {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId     String        @map("post_id") @db.Uuid
  post       Post          @relation(fields: [postId], references: [id])
  reporterId String        @map("reporter_id") @db.Uuid
  reporter   SocialAccount @relation(fields: [reporterId], references: [id])
  reason     String        @db.VarChar(50)
  details    String?
  resolvedAt DateTime?     @map("resolved_at") @db.Timestamptz
  resolvedBy String?       @map("resolved_by") @db.Uuid
  resolution String?       @db.VarChar(50) // REMOVED, NO_ACTION, SHADOW_BAN, SUSPEND
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@map("post_reports")
  @@schema("social")
}

// ─── Connection (friend) — bidirectional, requires accept ────────────────
enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED

  @@schema("social")
}

model Connection {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requesterId String           @map("requester_id") @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid
  status      ConnectionStatus @default(PENDING)
  message     String?
  respondedAt DateTime?        @map("responded_at") @db.Timestamptz
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([requesterId, recipientId])
  @@index([requesterId])
  @@index([recipientId, status])
  @@map("connections")
  @@schema("social")
}

// ─── Notification — in-app, per-user ─────────────────────────────────────
enum NotificationType {
  POST_COMMENT
  POST_REACTION
  COMMENT_REPLY
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  FOLLOW
  MESSAGE
  REQUEST_OFFER
  REQUEST_OFFER_ACCEPTED
  REQUEST_OFFER_REJECTED
  GROUP_INVITE
  BOOKING_CREATED
  BOOKING_STATUS
  PAYMENT_RECEIVED
  VISA_STATUS
  VISA_REQUEST
  SYSTEM

  @@schema("social")
}

model Notification {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String?          @map("tenant_id") @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid // user.id (not SocialAccount.id)
  actorId     String?          @map("actor_id") @db.Uuid // user.id who triggered it
  type        NotificationType
  title       String           @db.VarChar(200)
  body        String?
  link        String? // /social/posts/:id, /messages/:id
  data        Json?            @db.JsonB
  readAt      DateTime?        @map("read_at") @db.Timestamptz
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt(sort: Desc)])
  @@map("notifications")
  @@schema("social")
}

// ─── Public website inquiries (contact / partner / careers / newsletter / demo) ──
enum InquiryType {
  CONTACT
  PARTNER
  CAREERS
  NEWSLETTER
  DEMO
  SUPPORT

  @@schema("core")
}

enum InquiryStatus {
  NEW
  IN_REVIEW
  RESOLVED
  ARCHIVED

  @@schema("core")
}

model PublicInquiry {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type      InquiryType
  status    InquiryStatus @default(NEW)
  name      String?       @db.VarChar(160)
  email     String        @db.VarChar(200)
  phone     String?       @db.VarChar(40)
  company   String?       @db.VarChar(200)
  subject   String?       @db.VarChar(240)
  message   String?
  metadata  Json?         @db.JsonB // role interest, position applied for, source page, etc.
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@index([type, status])
  @@index([createdAt(sort: Desc)])
  @@map("public_inquiries")
  @@schema("core")
}

// ─── Marketplace Request (traveler-side) + Offer (provider-side) ─────────
enum RequestStatus {
  OPEN
  IN_NEGOTIATION
  FULFILLED
  CLOSED
  EXPIRED

  @@schema("marketplace")
}

enum RequestServiceType {
  HOTEL
  TRANSPORT
  VISA
  PACKAGE
  GUIDE
  CATERING
  OTHER

  @@schema("marketplace")
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN

  @@schema("marketplace")
}

model MarketplaceRequest {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  travelerId      String             @map("traveler_id") @db.Uuid // user.id
  serviceType     RequestServiceType @map("service_type")
  title           String             @db.VarChar(200)
  description     String?
  city            String?
  dateFrom        DateTime?          @map("date_from") @db.Timestamptz
  dateTo          DateTime?          @map("date_to") @db.Timestamptz
  travelers       Int                @default(1)
  budgetMinCents  BigInt?            @map("budget_min_cents")
  budgetMaxCents  BigInt?            @map("budget_max_cents")
  currency        String             @default("SAR") @db.VarChar(8)
  requirements    Json?              @db.JsonB
  status          RequestStatus      @default(OPEN)
  acceptedOfferId String?            @map("accepted_offer_id") @db.Uuid
  expiresAt       DateTime?          @map("expires_at") @db.Timestamptz
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  offers RequestOffer[]

  @@index([tenantId, status])
  @@index([travelerId, status])
  @@index([serviceType, status])
  @@map("marketplace_requests")
  @@schema("marketplace")
}

model RequestOffer {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId   String             @map("request_id") @db.Uuid
  request     MarketplaceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  providerId  String             @map("provider_id") @db.Uuid // user.id of provider
  vendorId    String?            @map("vendor_id") @db.Uuid // optional link to marketplace.Vendor
  title       String             @db.VarChar(200)
  description String?
  priceCents  BigInt             @map("price_cents")
  currency    String             @default("SAR") @db.VarChar(8)
  validUntil  DateTime?          @map("valid_until") @db.Timestamptz
  status      OfferStatus        @default(PENDING)
  respondedAt DateTime?          @map("responded_at") @db.Timestamptz
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  @@index([requestId, status])
  @@index([providerId, status])
  @@map("request_offers")
  @@schema("marketplace")
}

// ============================================================
// AUDIT SCHEMA — Immutable event log
// ============================================================

model AuditLog {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String?     @map("tenant_id") @db.Uuid
  actorId     String?     @map("actor_id") @db.Uuid
  actorEmail  String?     @map("actor_email")
  action      AuditAction
  namespace   String      @db.VarChar(50) // plugin namespace
  resource    String      @db.VarChar(100)
  resourceId  String?     @map("resource_id")
  beforeState Json?       @map("before_state") @db.JsonB
  afterState  Json?       @map("after_state") @db.JsonB
  metadata    Json?       @db.JsonB
  ipAddress   String?     @map("ip_address")
  userAgent   String?     @map("user_agent")
  requestId   String?     @map("request_id")
  occurredAt  DateTime    @default(now()) @map("occurred_at") @db.Timestamptz

  @@index([tenantId, occurredAt])
  @@index([actorId])
  @@index([resource, resourceId])
  @@map("audit_logs")
  @@schema("audit")
}

// ─── Payment gateway plumbing ───────────────────────────────────────────
model PaymentTransaction {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  paymentId String  @map("payment_id") @db.Uuid
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  /// INTENT_CREATED | AUTHORIZED | CAPTURED | FAILED | REFUNDED | WEBHOOK_RECEIVED
  type        String  @db.VarChar(40)
  provider    String  @db.VarChar(40)
  amountCents BigInt  @default(0) @map("amount_cents")
  currency    String  @default("SAR") @db.Char(3)
  providerRef String? @map("provider_ref") @db.VarChar(200)
  status      String? @db.VarChar(40)
  message     String? @db.VarChar(400)
  payload     Json?   @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  actorId   String?  @map("actor_id") @db.Uuid

  @@index([tenantId, paymentId])
  @@index([paymentId, createdAt])
  @@map("payment_transactions")
  @@schema("plugin_finance")
}

/// Every webhook delivery, stored so a replay is recognised and ignored.
/// A payer's customer record at a payment provider (e.g. Stripe customer id).
model PaymentCustomer {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  provider           String   @db.VarChar(40)
  providerCustomerId String   @map("provider_customer_id") @db.VarChar(200)
  livemode           Boolean  @default(false)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([userId, provider, livemode])
  @@map("payment_customers")
  @@schema("plugin_finance")
}

model PaymentWebhookEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider    String    @db.VarChar(40)
  eventId     String    @map("event_id") @db.VarChar(200)
  type        String    @db.VarChar(80)
  paymentId   String?   @map("payment_id") @db.Uuid
  tenantId    String?   @map("tenant_id") @db.Uuid
  signature   String?   @db.VarChar(400)
  payload     Json?     @db.JsonB
  processedAt DateTime? @map("processed_at") @db.Timestamptz
  result      String?   @db.VarChar(200)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@unique([provider, eventId])
  @@index([paymentId])
  @@map("payment_webhook_events")
  @@schema("plugin_finance")
}
