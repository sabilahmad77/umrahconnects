model Invoice {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String        @map("tenant_id") @db.Uuid
  invoiceRef String        @unique @map("invoice_ref") // INV-2026-00001
  status     InvoiceStatus @default(DRAFT)
  type       String        @default("CUSTOMER") @db.VarChar(30) // CUSTOMER / VENDOR / CREDIT_NOTE

  // Parties
  bookingId       String? @map("booking_id") @db.Uuid
  pilgrimId       String? @map("pilgrim_id") @db.Uuid
  vendorId        String? @map("vendor_id") @db.Uuid
  issuedToName    String  @map("issued_to_name")
  issuedToAddress Json?   @map("issued_to_address") @db.JsonB

  // Amounts (all bigint minor units)
  subtotalCents BigInt @map("subtotal_cents")
  taxCents      BigInt @default(0) @map("tax_cents")
  discountCents BigInt @default(0) @map("discount_cents")
  totalCents    BigInt @map("total_cents")
  paidCents     BigInt @default(0) @map("paid_cents")
  currency      String @default("SAR") @db.Char(3)

  // Dates
  issuedAt DateTime? @map("issued_at") @db.Date
  dueAt    DateTime? @map("due_at") @db.Date
  paidAt   DateTime? @map("paid_at") @db.Timestamptz

  // ZATCA fields (for KSA e-invoicing)
  zatcaUuid      String?   @map("zatca_uuid") @db.Uuid
  zatcaHash      String?   @map("zatca_hash")
  zatcaQrCode    String?   @map("zatca_qr_code")
  zatcaClearedAt DateTime? @map("zatca_cleared_at") @db.Timestamptz

  lineItems Json    @default("[]") @map("line_items") @db.JsonB
  notes     String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy String?  @map("created_by") @db.Uuid

  payments Payment[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([invoiceRef])
  @@map("invoices")
  @@schema("plugin_finance")
}

model Payment {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  invoiceId        String?       @map("invoice_id") @db.Uuid
  invoice          Invoice?      @relation(fields: [invoiceId], references: [id])
  bookingId        String?       @map("booking_id") @db.Uuid
  pilgrimId        String?       @map("pilgrim_id") @db.Uuid
  /// Marketplace checkout: the listing booking being paid and the traveler paying it.
  listingBookingId String?       @map("listing_booking_id") @db.Uuid
  payerUserId      String?       @map("payer_user_id") @db.Uuid
  status           PaymentStatus @default(PENDING)

  // Amount
  amountCents BigInt   @map("amount_cents")
  currency    String   @db.Char(3)
  fxRateSar   Decimal? @map("fx_rate_sar") @db.Decimal(15, 6) // rate to SAR at time of payment

  // Gateway
  gateway         String  @db.VarChar(50) // stripe, hyperpay, midtrans, tabby, tamara, cash
  gatewayRef      String? @map("gateway_ref") @db.VarChar(200)
  gatewayStatus   String? @map("gateway_status") @db.VarChar(50)
  gatewayResponse Json?   @map("gateway_response") @db.JsonB

  // BNPL
  isBnpl          Boolean @default(false) @map("is_bnpl")
  bnplProvider    String? @map("bnpl_provider") @db.VarChar(50)
  installmentPlan Json?   @map("installment_plan") @db.JsonB

  idempotencyKey String    @unique @map("idempotency_key")
  paidAt         DateTime? @map("paid_at") @db.Timestamptz
  failedAt       DateTime? @map("failed_at") @db.Timestamptz
  failureReason  String?   @map("failure_reason")
  refundedCents  BigInt    @default(0) @map("refunded_cents")
  refundedAt     DateTime? @map("refunded_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  transactions PaymentTransaction[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([idempotencyKey])
  @@index([gateway, gatewayRef])
  @@index([listingBookingId])
  @@index([payerUserId])
  @@map("payments")
  @@schema("plugin_finance")
}

model BudgetPlan {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  planRef  String @unique @map("plan_ref") // BP-2026-00001

  // Client
  clientUserId String? @map("client_user_id") @db.Uuid
  clientName   String  @map("client_name") @db.VarChar(200)
  clientType   String  @default("TRAVELER") @map("client_type") @db.VarChar(20) // TRAVELER / OPERATOR / EXTERNAL
  requestId    String? @map("request_id") @db.Uuid // optional marketplace request link

  // Trip parameters
  destination String?   @db.VarChar(120)
  dateFrom    DateTime? @map("date_from") @db.Date
  dateTo      DateTime? @map("date_to") @db.Date
  travelers   Int       @default(1)
  currency    String    @default("SAR") @db.VarChar(8)

  // Budget breakdown (minor units)
  totalBudgetCents     BigInt @default(0) @map("total_budget_cents")
  hotelBudgetCents     BigInt @default(0) @map("hotel_budget_cents")
  transportBudgetCents BigInt @default(0) @map("transport_budget_cents")
  visaBudgetCents      BigInt @default(0) @map("visa_budget_cents")
  packageBudgetCents   BigInt @default(0) @map("package_budget_cents")
  otherBudgetCents     BigInt @default(0) @map("other_budget_cents")

  commissionRate  Decimal? @map("commission_rate") @db.Decimal(5, 2) // percent
  commissionCents BigInt   @default(0) @map("commission_cents")

  suggestedOptions Json    @default("[]") @map("suggested_options") @db.JsonB
  finalPlan        Json?   @map("final_plan") @db.JsonB
  status           String  @default("DRAFT") @db.VarChar(20) // DRAFT / PROPOSED / ACCEPTED / COMPLETED / CANCELLED
  notes            String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy String?  @map("created_by") @db.Uuid

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("budget_plans")
  @@schema("plugin_finance")
}

model LedgerEntry {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  accountCode   String   @map("account_code") @db.VarChar(20)
  type          String   @db.VarChar(10) // DEBIT / CREDIT
