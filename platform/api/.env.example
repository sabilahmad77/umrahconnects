# Umrah Connect API — environment template (names + safe local placeholders only).
# Local: copy to platform/api/.env. Machine-specific overrides go in .env.local (loaded first).
# Production: see infrastructure/kvm/.env.production.example — the API refuses to start
# with unsafe production values (src/bootstrap/env.validation.ts).

NODE_ENV=development
PORT=4000
# HOST=0.0.0.0
# Reverse-proxy hops to trust for client IPs (rate limiting). Local default: loopback. KVM behind Caddy: 1
# TRUST_PROXY=loopback
# Shared secret the web proxy sends as X-UC-Proxy-Secret so the API can trust the client IP header
# (Vercel: x-vercel-forwarded-for). Set the same value in the web app. Leave unset to ignore the header.
# PROXY_SHARED_SECRET=
# CLIENT_IP_HEADER=x-vercel-forwarded-for

# PostgreSQL (schemas are created by `prisma migrate deploy`)
DATABASE_URL="postgresql://umrah@localhost:5432/umrah_connects"
# Disposable database for the e2e suite (name must end in _test). Default: DATABASE_URL with db umrah_connects_test
# TEST_DATABASE_URL=

# Auth
JWT_SECRET=dev-local-jwt-secret-change-me-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# AUTH_MAX_FAILED_LOGINS=10
# AUTH_LOCKOUT_MINUTES=15
# Keep returning the refresh token in JSON until the web client relies on the httpOnly cookie only.
# AUTH_REFRESH_TOKEN_IN_BODY=true
# ONBOARDING_REQUIRE_VERIFIED_EMAIL=true

# Web origin (links in emails, OAuth redirects) and allowed browser origins
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# CORS_ORIGIN_REGEX=          # optional, e.g. ^https://umrah-connect-[a-z0-9-]+\.vercel\.app$ for previews
# PUBLIC_API_BASE_URL=/proxy-api   # browser-visible API base for signed document links

# Rate limiting (per client IP; auth routes have stricter per-route limits)
# THROTTLE_LIMIT=600
# THROTTLE_TTL_MS=60000
# THROTTLE_DISABLED=false

# Storage: local | r2 | s3
STORAGE_DRIVER=local
# STORAGE_LOCAL_PERSISTENT=false
# S3_ENDPOINT=                 # R2: https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=                   # s3 only
# S3_BUCKET=                   # private documents bucket
# S3_PUBLIC_BUCKET=            # public media bucket
# S3_PUBLIC_BASE_URL=          # public URL of the media bucket
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# DOCUMENT_URL_TTL_SECONDS=300

# Payments: sandbox (dev/test only) | stripe
PAYMENT_PROVIDER=sandbox
# SANDBOX_WEBHOOK_SECRET=      # random per boot when unset
# PAYMENT_SANDBOX_ENABLED=true
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PUBLISHABLE_KEY=

# Email: log (dev only) | smtp | none
MAIL_DRIVER=log
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=

# Google Sign-In (server-side OIDC; the secret never reaches the browser)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/proxy-api/auth/google/callback

# Optional event bus (not required)
KAFKA_ENABLED=false
# KAFKA_BROKERS=
# KAFKA_CLIENT_ID=umrah-connects-api

# Development seeds
# DEMO_PASSWORD=
# Production Super Admin bootstrap (prisma/scripts/bootstrap-platform-admin.ts)
# PLATFORM_ADMIN_EMAIL=
# PLATFORM_ADMIN_PASSWORD=
