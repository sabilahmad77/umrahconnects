# Umrah Connect API — local development env
# Copy to platform/api/.env  (Prisma and Nest read this file)
# These defaults are DEV-ONLY. Production values live in the Render dashboard.

NODE_ENV=development
PORT=4000

# Local Postgres 15 (multiSchema). Create with:
#   createuser umrah && createdb umrah_connects -O umrah
DATABASE_URL="postgresql://umrah@localhost:5432/umrah_connects"

# Optional infra — safe to leave off locally
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=umrah-connects-api
KAFKA_GROUP_ID=umrah-connects-consumer
KAFKA_ENABLED=false

# JWT — any long random strings work for local dev
JWT_SECRET=dev-local-jwt-secret-change-in-production
JWT_REFRESH_SECRET=dev-local-refresh-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

APP_URL=http://localhost:3000

THROTTLE_SHORT_LIMIT=100
THROTTLE_MEDIUM_LIMIT=500
THROTTLE_LONG_LIMIT=2000
