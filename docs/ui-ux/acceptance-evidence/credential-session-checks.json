{
  "scope": "one isolated local QA account only; no password changed",
  "checks": [
    {
      "action": "temporary account login",
      "status": 200
    },
    {
      "action": "/auth/change-password non-mutating validation",
      "status": 400,
      "message": [
        "currentPassword must be shorter than or equal to 128 characters",
        "currentPassword must be longer than or equal to 1 characters",
        "currentPassword must be a string",
        "Password must be 8\u2013128 characters and include a letter and a number",
        "newPassword must be a string"
      ]
    },
    {
      "action": "/auth/change-password non-mutating validation",
      "status": 401,
      "message": "Current password is incorrect"
    },
    {
      "action": "temporary account logout all sessions",
      "status": 200
    },
    {
      "action": "revoked temporary access token",
      "status": 401
    },
    {
      "action": "revoked temporary refresh cookie",
      "status": 401
    }
  ]
}