# OS
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml

# Terraform state (never commit state files)
*.tfstate
*.tfstate.backup
.terraform/
.terraform.lock.hcl

# Secrets — never commit these
*.pem
*.key
*.p12
*.pfx
secrets/

# Mobile
.expo
ios/Pods
android/.gradle
android/app/build

# Storybook
storybook-static

# Build artifacts / large binaries — not source (host these elsewhere)
*.apk
apps/web/public/*.apk

# NOTE: .github/workflows/ was previously ignored because the token in use
# lacked the `workflow` scope. The current gh token has it, and ignoring CI
# config risks silently losing it on a machine migration, so it is tracked.

# Local QA/audit outputs — keep the repo lean.
# NOTE: the committed role-sign-off screenshots live in audit/screens/ and are
# deliberately tracked; this rule targets ad-hoc local output only.
audit/screenshots/
audit/*.pdf
audit/*.png

# Locally stored uploads — user content, never committed
uploads/
