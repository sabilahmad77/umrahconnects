# Umrah Connect Web — local development env
# Copy to apps/web/.env.local
# NEXT_PUBLIC_API_URL uses the same-origin proxy (next.config rewrites
# /proxy-api -> http://localhost:4000). Keep it relative so it works on any
# host/tunnel without a rebuild.

NEXT_PUBLIC_API_URL=/proxy-api
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=dev_nextauth_secret_umrah_connects_local
NEXTAUTH_URL=http://localhost:3000
